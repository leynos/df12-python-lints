          "start_col": 0,
          "end_col": 18
        },
        "content": "def longest_valid_streak(flags: list[bool]) -\u003e int:\n    \"\"\"Measure the longest run of consecutive valid flags.\n\n    Parameters\n    ----------\n    flags : list[bool]\n        Validity flags in observation order.\n\n    Returns\n    -------\n    int\n        Length of the longest unbroken run of ``True`` values.\n    \"\"\"\n    longest = 0\n    current = 0\n    for flag in flags:\n        if flag:\n            current += 1\n            longest = max(longest, current)\n        else:\n            current = 0\n    return longest",
        "hash": "f098bd92815387c7",
